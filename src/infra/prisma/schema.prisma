generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMIN
  CLIENTE
}

enum StatusPedido {
  RECEBIDO
  EM_PREPARACAO
  DESPACHADO
  ENTREGUE
}

model Usuario {
  id              String      @id @default(uuid())
  nome            String
  email           String      @unique
  senha           String
  tipo            TipoUsuario @default(CLIENTE)
  dataCriacao     DateTime    @default(now())
  dataAtualizacao DateTime    @updatedAt
  cliente         Cliente?
}

model Cliente {
  id              String    @id @default(uuid())
  nomeCompleto    String
  contato         String
  endereco        String
  status          Boolean   @default(true) // Ativo/Inativo
  dataCriacao     DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  usuarioId       String    @unique
  pedidos         Pedido[]
}

model Produto {
  id                 String          @id @default(uuid())
  nomeProduto        String
  descricao          String
  preco              Float
  quantidadeEmEstoque Int
  dataCriacao        DateTime        @default(now())
  dataAtualizacao    DateTime        @updatedAt
  itensDoPedido      ItemDoPedido[]
}

model Pedido {
  id             String       @id @default(uuid())
  statusPedido   StatusPedido @default(RECEBIDO)
  dataDoPedido   DateTime     @default(now())
  totalDoPedido  Float
  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  clienteId      String
  itensDoPedido  ItemDoPedido[]
}

model ItemDoPedido {
  id               String  @id @default(uuid())
  quantidade       Int
  precoPorUnidade  Float
  subtotal         Float
  pedido           Pedido  @relation(fields: [pedidoId], references: [id])
  pedidoId         String
  produto          Produto @relation(fields: [produtoId], references: [id])
  produtoId        String
}

model RelatorioDeVendas {
  id               String   @id @default(uuid())
  periodo          DateTime
  totalDeVendas    Float
  produtosVendidos Int
  caminhoDoArquivo String
}